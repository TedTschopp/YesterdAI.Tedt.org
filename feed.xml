<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/"><channel><title>Yesterday in AI</title><link>{{ '/' | absolute_url | xml_escape }}</link><description>{{ site.description | xml_escape }}</description><language>en</language><atom:link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml"/>{% assign articles = site.articles | sort: 'published_at' | reverse %}{% for article in articles limit: 50 %}<item><title>{{ article.title | xml_escape }}</title><link>{{ article.url | absolute_url | xml_escape }}</link><guid isPermaLink="true">{{ article.url | absolute_url | xml_escape }}</guid><pubDate>{{ article.published_at | date_to_rfc822 }}</pubDate><atom:updated>{{ article.modified_at | default: article.published_at | date_to_xmlschema }}</atom:updated><description>{{ article.summary | xml_escape }}</description><content:encoded>{{ article.content | xml_escape }}</content:encoded><category>{{ article.section | xml_escape }}</category></item>{% endfor %}</channel></rss>
