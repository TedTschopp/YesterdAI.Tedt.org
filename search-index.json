layout: null
---
[{% assign articles = site.articles | sort: 'edition_date' | reverse %}{% for article in articles %}{% unless forloop.first %},{% endunless %}{"id":{{ article.article_id | jsonify }},"url":{{ article.url | jsonify }},"title":{{ article.title | jsonify }},"summary":{{ article.summary | jsonify }},"section":{{ article.section | slugify | jsonify }},"edition_date":{{ article.edition_date | jsonify }},"text":{{ article.content | strip_html | normalize_whitespace | jsonify }}}{% endfor %}]
